---
import type { BreadcrumbsStyle } from '@lib/utils/types';
import type { CollectionEntry } from 'astro:content';
import DefaultHeader from '@components/pageHeaders/DefaultHeader.astro';
import PlacesIndex from '@components/places/PlacesIndex.astro';
import PostsIndex from '@components/posts/PostsIndex.astro';

interface Props {
    page: CollectionEntry<'pages'>;
}

const { page } = Astro.props;

let Index;
switch (page.data.index?.collection) {
    case 'posts':
        Index = PostsIndex;
        break;
    case 'places':
        Index = PlacesIndex;
        break;
    default:
        Index = PostsIndex;
        break;
}
---

<DefaultHeader title={page.data.title} />
{
    page.data.index?.collection && (
        <div
            class="index-wrapper"
            data-index={page.data.index.collection}
            id={`${page.data.index.collection}-index`}
        >
            <Index />
        </div>
    )
}
