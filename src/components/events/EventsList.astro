---
import type { CollectionEntry } from 'astro:content';
import EventPreviewList from '@components/events/EventPreviewList.astro';

interface Props {
    events: CollectionEntry<'events'>[];
    showDatePreview?: boolean; // whether to show the `MMM-D` white box date preview in the upper right corner - only show for upcoming
}

const { events, showDatePreview = false } = Astro.props;
---

<div class="events-list">
    {
        events.map((event) => (
            <EventPreviewList event={event} showDatePreview={showDatePreview} />
        ))
    }
</div>

<style>
    .events-list {
        container: eventsListWrapper / inline-size;
    }

    @container eventsListWrapper (width < 700px) {
        :global(.event-preview-list) {
            grid-template-columns: 1fr;
            row-gap: var(--space-m);
        }

        :global(.event-preview-list .image-wrapper) {
            order: -1;
        }
    }
</style>
