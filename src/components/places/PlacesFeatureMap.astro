---
import { getCollection } from 'astro:content';
import v from 'voca';
// TODO: implement filtering by search/text input and category select
// @link https://docs.mapbox.com/mapbox-gl-js/example/filter-markers-by-input/
// @link https://docs.mapbox.com/mapbox-gl-js/example/filter-markers/

const historicalPeriods = await getCollection('historicalPeriods');
---

<div class="map-wrapper">
    <div id="map"></div>
    <div class="filters">
        <fieldset class="filter-group | periods-filter">
            <legend class="small-title">Filter by Period</legend>
            {
                historicalPeriods
                    .sort((a, b) => (a.data.title > b.data.title ? 1 : -1))
                    .map((period) => {
                        const titleSlug = v.slugify(period.data.title);
                        return (
                            <div class="checkbox-group">
                                <input
                                    id={titleSlug}
                                    name={titleSlug}
                                    type="checkbox"
                                />
                                <label for={titleSlug}>
                                    {period.data.title}
                                </label>
                            </div>
                        );
                    })
            }
        </fieldset>
    </div>
</div>

<script>
    import 'mapbox-gl/dist/mapbox-gl.css';
    import htm from 'htm';
    import mapboxgl from 'mapbox-gl';
    import v from 'voca';
    import vhtml from 'vhtml';

    const html = htm.bind(vhtml);

    type Feature = {
        type: 'Feature';
        geometry: {
            type: 'Point';
            coordinates: [number, number];
        };
        properties: Record<string, any>;
    };

    const mapWrapper = document.querySelector<HTMLElement>('.map-wrapper');
    const periodFilters = document.querySelectorAll<HTMLInputElement>(
        '.periods-filter input',
    );

    // fetch all features to filter and reload map using `setData()`
    const allFeatures: Feature[] = [];
    fetch('/sites/index.geojson')
        .then((res) => res.json())
        .then((data) => {
            allFeatures.push(...data.features);
        });

    const map = new mapboxgl.Map({
        accessToken:
            'pk.eyJ1IjoiZHRzYXVuZGVycy11Y2xhIiwiYSI6ImNtbnhvbXZvNzA0YmsycHE1eTIyOG16dHEifQ.avl_JBDSM0Iulkp2TxYj3A',
        container: 'map',
        zoom: 4.5,
        center: [48.3, 32.5],
        style: 'mapbox://styles/dtsaunders-ucla/cmvsmoms1003a01rm27oa8eap',
        projection: 'mercator',
        cooperativeGestures: true,
    });

    map.on('load', () => {
        map.addControl(new mapboxgl.NavigationControl());
        map.addControl(new mapboxgl.ScaleControl());

        // add extra tilesets
        // map.addSource('cawm-tileset', {
        //     type: 'raster',
        //     tiles: ['https://cawm.lib.uiowa.edu/tiles/{z}/{x}/{y}.png'],
        //     tileSize: 256,
        //     attribution: '© Consortium of Ancient World Mappers',
        // });
        // map.addLayer({
        //     id: 'cawm-tileset-layer',
        //     type: 'raster',
        //     source: 'cawm-tileset',
        // });

        // add places source starting data - fetch URL
        map.addSource('places', {
            type: 'geojson',
            generateId: true,
            data: `/sites/index.geojson`,
            cluster: true,
            clusterMaxZoom: 8,
            clusterRadius: 50,
        });

        // add layers
        // 1. cluster circles
        map.addLayer({
            id: 'places-cluster',
            type: 'circle',
            source: 'places',
            filter: ['has', 'point_count'],
            paint: {
                // Use step expressions (https://docs.mapbox.com/style-spec/reference/expressions/#step)
                // with three steps to implement three types of circles:
                'circle-color': [
                    'step',
                    ['get', 'point_count'],
                    '#005587',
                    20,
                    '#003B5C',
                    50,
                    '#003B5C',
                ],
                'circle-radius': [
                    'step',
                    ['get', 'point_count'],
                    20,
                    20,
                    30,
                    50,
                    40,
                ],
                'circle-emissive-strength': 1,
            },
        });
        // 2. cluster counts
        map.addLayer({
            id: 'places-cluster-count',
            type: 'symbol',
            source: 'places',
            filter: ['has', 'point_count'],
            layout: {
                'text-field': ['get', 'point_count_abbreviated'],
                'text-font': ['DIN Offc Pro Medium', 'Arial Unicode MS Bold'],
                'text-size': 14,
            },
            paint: {
                'text-color': 'white',
            },
        });
        // 3. primary place points
        map.addLayer({
            id: 'places-layer',
            type: 'circle',
            source: 'places',
            filter: ['!', ['has', 'point_count']],
            paint: {
                'circle-color': '#2774ae',
                'circle-stroke-color': 'white',
                'circle-stroke-width': 1,
                'circle-radius': 7,
            },
        });

        // add cluster interaction
        map.addInteraction('click-clusters', {
            type: 'click',
            target: { layerId: 'places-cluster' },
            handler: (e) => {
                const features = map.queryRenderedFeatures(e.point, {
                    layers: ['places-cluster'],
                });
                // @ts-expect-error
                const clusterId = features[0].properties.cluster_id;
                // @ts-expect-error
                map.getSource('places')?.getClusterExpansionZoom(
                    clusterId,
                    (err: any, zoom: any) => {
                        if (err) return;

                        map.easeTo({
                            // @ts-expect-error
                            center: features[0].geometry.coordinates,
                            zoom,
                        });
                    },
                );
            },
        });

        // add info popups
        map.addInteraction('places-click-interaction', {
            type: 'click',
            target: { layerId: 'places-layer' },
            handler: (e) => {
                const coordinates = e.feature?.geometry.coordinates.slice();
                const description = html`
                    <div
                        class="mapbox-popup__box | flow"
                        data-placeID="${e.feature?.id}"
                        data-tempo="presto"
                    >
                        ${
                            e.feature?.properties.featured_image
                                ? html`
                                      <img
                                          alt="${e.feature?.properties.title}"
                                          src="${e.feature?.properties.featured_image}"
                                          width="300"
                                          height="200"
                                      />
                                  `
                                : ''
                        }
                        <header>
                            <p class="mapbox-popup__title">
                                ${e.feature?.properties.title}
                            </p>
                            <p class="persian-text" dir="rtl">
                                ${e.feature?.properties.persian_name}
                            </p>
                        </header>
                        <p>${e.feature?.properties.description}</p>
                        <a
                            class="button-link"
                            data-style="primary"
                            data-size="small"
                            href="/sites/${e.feature?.properties.place_id}"
                            >View Article</a
                        >
                    </div>
                `;

                new mapboxgl.Popup()
                    .setLngLat(coordinates)
                    .setHTML(description as string)
                    .addTo(map);
            },
        });

        // change cursor to pointer when mouse is over cluster
        map.addInteraction('clusters-mouseenter-interaction', {
            type: 'mouseenter',
            target: { layerId: 'places-cluster' },
            handler: () => {
                map.getCanvas().style.cursor = 'pointer';
            },
        });

        // change cursor back to pointer when mouse leaves cluster
        map.addInteraction('clusters-mouseleave-interaction', {
            type: 'mouseleave',
            target: { layerId: 'places-cluster' },
            handler: () => {
                map.getCanvas().style.cursor = '';
            },
        });

        // change cursor to pointer when the mouse is over a popup
        map.addInteraction('places-mouseenter-interaction', {
            type: 'mouseenter',
            target: { layerId: 'places-layer' },
            handler: () => {
                map.getCanvas().style.cursor = 'pointer';
            },
        });
        // change cursor back to pointer when the mouse leaves a popup
        map.addInteraction('places-mouseleave-interaction', {
            type: 'mouseleave',
            target: { layerId: 'places-layer' },
            handler: () => {
                map.getCanvas().style.cursor = '';
            },
        });

        // Filters fetched dataset in memory and uses `setData` to reassign filtered points. This reloads the map and clustering automatically. Prefer this to calling `setFilter` on layers since this only targets layers and not the source.
        function filterPeriods() {
            const checked = [...periodFilters]
                .filter((el) => el.checked)
                .map((el) => el.id);

            const filtered = checked.length
                ? allFeatures.filter((f) =>
                      f.properties.historical_periods.some((p: string) =>
                          checked.includes(v.slugify(p)),
                      ),
                  )
                : allFeatures;

            // @ts-expect-error
            map.getSource('places').setData({
                type: 'FeatureCollection',
                features: filtered,
            });
        }

        // filter listeners
        periodFilters.forEach((filter) => {
            filter.addEventListener('change', () => {
                filterPeriods();
                /*
                const checked = [...periodFilters]
                    .filter((el) => el.checked)
                    .map((el) => el.id);

                if (!checked.length) {
                    map.setFilter('places-layer', null);
                    return;
                }

                // use `any` (OR clause) to simulate JS `some` array overlap method
                // swap with `all` to match every checked category
                map.setFilter('places-layer', [
                    'any',
                    ...checked.map((id) => [
                        'in',
                        id,
                        ['get', 'historical_periods'],
                    ]),
                ]);*/
            });
        });
    });
    // map.on('dragend', () => {
    //     console.log('MAP CENTER', map.getCenter());
    //     console.log('MAP ZOOM', map.getZoom());
    // });
</script>

<style>
    .map-wrapper {
        display: flex;
        aspect-ratio: 21/9;
        width: 100%;
        height: auto;
        padding: var(--gutter-spacing);
        padding-block-end: 0;
    }

    #map {
        height: 100%;
        width: 100%;
    }

    .filters {
        order: -1;
        width: 12rem;
        margin-inline-end: 1rem;
    }

    .periods-filter {
        border: none;

        & legend {
            font-size: var(--step--1);
            color: var(--ucla-primary-blue);
            margin-block-end: 0.5rem;
            padding-block-end: 0.5rem;
            border-block-end: 1px solid var(--site-border);
        }
    }

    .checkbox-group {
        display: flex;
        gap: 0.25rem;
        font-size: var(--step--1);
        margin-block-start: 0.25rem;

        &:hover {
            color: var(--ucla-primary-blue);
        }
    }
</style>
