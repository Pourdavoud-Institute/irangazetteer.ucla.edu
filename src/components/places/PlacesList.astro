---
import { type CollectionEntry } from 'astro:content';
import PlacePreview from './PlacePreview.astro';
import v from 'voca';

interface Props {
    places: CollectionEntry<'places'>[];
}

const { places } = Astro.props;
---

<ul class="places-list">
    {
        places
            .sort((a, b) => {
                const titleA = v
                    .chain(a.data.title)
                    .latinise()
                    .slugify()
                    .value();
                const titleB = v
                    .chain(b.data.title)
                    .latinise()
                    .slugify()
                    .value();

                return titleA > titleB ? 1 : -1;
            })
            .map((place) => <PlacePreview place={place} />)
    }
</ul>

<style>
    .places-list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: var(--space-m);
        row-gap: var(--space-xl);
    }
</style>
