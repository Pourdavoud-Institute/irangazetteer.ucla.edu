---
import { type CollectionEntry } from 'astro:content';
import { SanityPlaceCategories } from '@lib/sanity/dicts';

interface Props {
    category?: CollectionEntry<'placeCategories'>;
}

const { category } = Astro.props;
---

{
    category && (
        <a
            class="tag | with-icon"
            data-theme={
                category.id === SanityPlaceCategories.endangered.id
                    ? 'warning'
                    : 'default'
            }
            href={category.data.slug}
        >
            {category.id === SanityPlaceCategories.featured.id && (
                <svg
                    aria-hidden="true"
                    fill="none"
                    height="24"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path d="M11 17L13 17L13 11L11 11L11 17ZM12 9C12.2833 9 12.521 8.904 12.713 8.712C12.9043 8.52067 13 8.28334 13 8C13 7.71667 12.9043 7.479 12.713 7.287C12.521 7.09567 12.2833 7 12 7C11.7167 7 11.4793 7.09567 11.288 7.287C11.096 7.479 11 7.71667 11 8C11 8.28333 11.096 8.52067 11.288 8.712C11.4793 8.904 11.7167 9 12 9ZM12 22C10.6167 22 9.31666 21.7373 8.1 21.212C6.88333 20.6873 5.825 19.975 4.925 19.075C4.025 18.175 3.31266 17.1167 2.788 15.9C2.26266 14.6833 2 13.3833 2 12C2 10.6167 2.26267 9.31667 2.788 8.1C3.31267 6.88333 4.025 5.825 4.925 4.925C5.825 4.025 6.88333 3.31233 8.1 2.787C9.31667 2.26233 10.6167 2 12 2C13.3833 2 14.6833 2.26234 15.9 2.787C17.1167 3.31234 18.175 4.025 19.075 4.925C19.975 5.825 20.6873 6.88334 21.212 8.1C21.7373 9.31667 22 10.6167 22 12C22 13.3833 21.7373 14.6833 21.212 15.9C20.6873 17.1167 19.975 18.175 19.075 19.075C18.175 19.975 17.1167 20.6873 15.9 21.212C14.6833 21.7373 13.3833 22 12 22Z" />
                </svg>
            )}
            {category.id === SanityPlaceCategories.endangered.id && (
                <svg
                    aria-hidden="true"
                    fill="none"
                    height="24"
                    viewBox="0 0 24 24"
                    width="24"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <path d="M0.999997 21L12 2L23 21L0.999997 21ZM12 18C12.2833 18 12.521 17.904 12.713 17.712C12.9043 17.5207 13 17.2833 13 17C13 16.7167 12.9043 16.4793 12.713 16.288C12.521 16.096 12.2833 16 12 16C11.7167 16 11.4793 16.096 11.288 16.288C11.096 16.4793 11 16.7167 11 17C11 17.2833 11.096 17.5207 11.288 17.712C11.4793 17.904 11.7167 18 12 18ZM11 15L13 15L13 10L11 10L11 15Z" />
                </svg>
            )}
            {category.data.title}
        </a>
    )
}

<style>
    .tag {
        display: inline-flex;
        gap: 0.5rem;
        align-items: center;
        font-size: var(--step-0);
        padding: 0.25rem 0.75rem;

        & svg {
            top: 0;
        }

        &[data-theme='warning'] {
            color: color-mix(
                in srgb,
                var(--ucla-state-gold--active),
                black 30%
            );
            background-color: color-mix(
                in srgb,
                var(--ucla-state-gold--default),
                white 85%
            );
            border-color: var(--ucla-state-gold--active);

            &:hover {
                background-color: color-mix(
                    in srgb,
                    var(--ucla-state-gold--default),
                    white 70%
                );
            }
        }
    }
</style>
