---
import { type CollectionEntry, getCollection } from 'astro:content';
import { isBefore, parse } from '@formkit/tempo';
import PostPreview from '@components/posts/PostPreview.astro';
import type { PostsList } from '@content/schemaFragments/pageModules';
import v from 'voca';

interface Props {
    module: PostsList;
    limit?: number; // default limit for events to show
    columns?: number; // default grid columns
}

const { module, limit = 3, columns = 3 } = Astro.props;

const posts = await getCollection('posts');
// console.log(module);

let showPosts: CollectionEntry<'posts'>[] = [];

if (module.selection == 'auto') {
    if (module.filter) {
        showPosts = posts.filter((post) =>
            post.data.categories.some(
                (category) => category._id === module.filter,
            ),
        );
    }
}

const sorted = showPosts.sort((a, b) => {
    const dateA = parse(a.data.displayDate, 'YYYY-MM-DD');
    const dateB = parse(b.data.displayDate, 'YYYY-MM-DD');
    return isBefore(dateA, dateB) ? 1 : -1;
});

// todo: add entries
---

<section
    class:list={[{ 'section-margin': module.options.sectionMargin }]}
    data-module={module._type}
>
    <div class="content-wrapper with-border-top">
        {
            module.heading && (
                <h2 class="heading" id={v.slugify(module.heading)}>
                    {module.heading}
                </h2>
            )
        }
        <div
            class="entries | collection-grid"
            style={`--grid-columns: ${columns}`}
        >
            {sorted.slice(0, limit).map((post) => <PostPreview post={post} />)}
        </div>
        <div class="cta-links | cluster">
            <a class="button-link" data-style="primary" href="/news"
                >View More News</a
            >
        </div>
    </div>
</section>

<style>
    .heading {
        margin-block-end: var(--space-l);
    }

    .collection-grid {
        column-gap: var(--space-xl);
    }

    .cta-links {
        --cluster-justify: center;
        margin-block-start: var(--space-2xl);
    }

    @media screen and (max-width: 768px) {
        .collection-grid {
            grid-template-columns: 1fr;
            row-gap: var(--space-l);
        }

        .cta-links {
            --cluster-justify: flex-start;
        }
    }
</style>
