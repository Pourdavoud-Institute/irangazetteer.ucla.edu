---
/** Figure gallery for rich text component. Figures are linked to text spans as a Portable Text `markDef`. For each block/paragraph, the images referenced in that block are rendered in a gallery below. See RichTextBlock. */
import type {
    FigureImage,
    SanityImage as SanityImageType,
} from '@lib/utils/types';
import SanityImage from '@components/SanityImage.astro';
import v from 'voca';

interface Props {
    images?: FigureImage[];
}

const { images } = Astro.props;
---

<div class="figure-gallery">
    {
        images?.map((markDef) => {
            if (markDef._type == 'figure_ref' && markDef.asset) {
                return (
                    <figure id={v.slugify(markDef.title as string)}>
                        <SanityImage
                            source={markDef as SanityImageType}
                            width={900}
                        />
                        <figcaption>
                            {markDef.title && (
                                <Fragment>
                                    <strong>{markDef.title}.</strong>{' '}
                                    {
                                        (markDef as SanityImageType).asset
                                            ?.description
                                    }{' '}
                                    <a
                                        class="image-link | with-icon"
                                        href={
                                            (markDef as SanityImageType).asset
                                                ?.url
                                        }
                                        target="_blank"
                                    >
                                        <svg
                                            fill="none"
                                            height="24"
                                            viewBox="0 0 24 24"
                                            width="24"
                                            xmlns="http://www.w3.org/2000/svg"
                                        >
                                            <path d="M19.6 21L13.3 14.7C12.8 15.1 12.225 15.4167 11.575 15.65C10.925 15.8833 10.2333 16 9.5 16C7.68333 16 6.146 15.371 4.888 14.113C3.62933 12.8543 3 11.3167 3 9.5C3 7.68333 3.62933 6.14567 4.888 4.887C6.146 3.629 7.68333 3 9.5 3C11.3167 3 12.8543 3.629 14.113 4.887C15.371 6.14567 16 7.68333 16 9.5C16 10.2333 15.8833 10.925 15.65 11.575C15.4167 12.225 15.1 12.8 14.7 13.3L21 19.6L19.6 21ZM9.5 14C10.75 14 11.8127 13.5627 12.688 12.688C13.5627 11.8127 14 10.75 14 9.5C14 8.25 13.5627 7.18733 12.688 6.312C11.8127 5.43733 10.75 5 9.5 5C8.25 5 7.18733 5.43733 6.312 6.312C5.43733 7.18733 5 8.25 5 9.5C5 10.75 5.43733 11.8127 6.312 12.688C7.18733 13.5627 8.25 14 9.5 14Z" />
                                        </svg>
                                        View full size
                                    </a>
                                </Fragment>
                            )}
                        </figcaption>
                    </figure>
                );
            }
        })
    }
</div>

<style>
    .figure-gallery {
        display: flex;
        gap: 0.5rem;
        align-items: baseline;
        scroll-snap-type: x mandatory;
        overflow-x: auto;
    }

    figure {
        flex: 1 0 45%;
        display: flex;
        flex-direction: column;
        /* height: var(--gallery-image-height, 22rem); */
        scroll-snap-align: start;
        width: auto;

        /* prevent single vertical images from eating up space */
        & img {
            max-height: 40rem;
            object-fit: contain;
        }
    }

    figcaption {
        margin-block-start: 0.5rem;
        font-size: var(--step--1);
    }

    .image-link {
        --icon-size: 1em;
        display: inline-flex;
        align-items: baseline;
        gap: 0.125rem;
        color: var(--ucla-primary-blue);
        font-weight: 500;

        &:hover {
            text-decoration: none;
        }

        & svg {
            top: 2px;
        }
    }
</style>
