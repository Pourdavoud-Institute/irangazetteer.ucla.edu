                            {person.data.cvSections.map((section, i) => (
                                <section>
                                    <details open={i == 0}>
                                        <summary>
                                            <h2
                                                id={v.slugify(
                                                    section._type ===
                                                        'cvSection'
                                                        ? section.title
                                                        : section.heading || '',
                                                )}
                                            >
                                                {section._type === 'cvSection'
                                                    ? section.title
                                                    : section.heading}
                                            </h2>
                                            <svg
                                                aria-hidden="true"
                                                class="ucla-plus closed"
                                                height="24"
