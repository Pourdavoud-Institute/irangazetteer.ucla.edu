---
import Breadcrumbs from '@components/navigation/Breadcrumbs.astro';
import DetailsFilter from '@components/interactive/DetailsFilter.astro';
import PageWrapper from '@components/document/PageWrapper.astro';
import PlacesList from '@components/places/PlacesList.astro';
import { formatPeriodDate } from '@lib/utils/formatPeriodDate';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
    const periods = await getCollection('historicalPeriods');
    const places = await getCollection('places');

    return periods.map((period) => ({
        params: {
            historicalPeriod: period.data.slug,
        },
        props: { period, allPeriods: periods, places },
    }));
}

const { period, allPeriods, places } = Astro.props;
---

<PageWrapper
    footerMargin
    id={period.id}
    template="historicalPeriodsShow"
    title={period.data.title}
>
    <Breadcrumbs collection="historicalPeriods" />
    <div class="period | content-wrapper">
        <header>
            <div class="eyebrow small-title">Historical Period</div>
            <h1>{period.data.title}</h1>
            {
                period.data.startDate && period.data.endDate && (
                    <p class="dates">{`${formatPeriodDate(period.data.startDate)} – ${formatPeriodDate(period.data.endDate)}`}</p>
                )
            }
        </header>
        <div class="list-spacer | with-sidebar">
            <div class="sidebar-panel | flow">
                <DetailsFilter
                    links={allPeriods
                        .sort((a, b) => (a.data.title > b.data.title ? 1 : -1))
                        .map((period) => ({
                            title: period.data.title,
                            href: period.data.slug,
                        }))}
                    title="Filter by Period"
                />
                <a
                    class="button-link"
                    data-size="small"
                    data-style="primary"
                    href="/sites">Show All</a
                >
            </div>
            <div class="main-panel">
                <PlacesList
                    places={period.data.places.map((place) => {
                        const linkedPlace = places.find(
                            (p) => p.id === place._id,
                        );
                        if (linkedPlace) {
                            return linkedPlace;
                        }
                    })}
                />
            </div>
        </div>
        <div>
            {period.data.places.map((place) => {})}
        </div>
    </div>
</PageWrapper>

<style>
    .eyebrow {
        font-size: var(--step--1);
        margin-block-end: var(--space-3xs);
    }

    .dates {
        margin-block-start: var(--space-s);
    }

    .period {
        margin-block-start: var(--space-2xl);
    }

    .list-spacer {
        margin-block-start: var(--space-2xl);
    }

    .with-sidebar {
        --sidebar-min-width: 13rem;
    }

    :global(.page[data-template='historicalPeriodsShow'] .sidebar-panel) {
        --flow-space: 1rem;
    }
</style>
