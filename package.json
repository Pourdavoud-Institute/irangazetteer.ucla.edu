{
    "name": "iran-gazetteer-astro",
    "description": "A front-end website template for the Archaeological Gazetteer of Iran, built with Astro.",
    "type": "module",
    "version": "1.0.0",
    "author": "Daniel Saunders <dtsaunders@humnet.ucla.edu> (https://daniel-saunders.com/)",
    "license": "MIT",
    "keywords": [
        "ucla",
        "academic",
        "university",
        "static site",
        "blog",
        "astro"
    ],
    "scripts": {
        "dev": "astro dev",
        "build": "astro build --timings && npm run index",
        "index": "npx -y pagefind --site dist",
        "preview": "astro preview",
        "astro": "astro",
        "test": "vitest"
    },
    "dependencies": {
        "@astrojs/sitemap": "^3.7.4",
        "@astrojs/vue": "^7.1.2",
        "@formkit/tempo": "^1.1.0",
        "@sanity/client": "^8.10.1",
        "@sanity/image-url": "^2.1.1",
        "astro": "^7.4.2",
        "astro-portabletext": "^0.11.4",
        "astro-seo": "^1.2.0",
        "browserslist": "^4.29.4",
        "fast-xml-parser": "^5.11.2",
        "fuse.js": "^7.5.0",
        "get-youtube-id": "^1.0.1",
        "groq": "^6.20.0",
        "htm": "^3.1.1",
        "lightningcss": "^1.33.0",
        "mapbox-gl": "^3.33.0",
        "reka-ui": "^2.11.0",
        "sharp": "^0.35.5",
        "vhtml": "^2.2.0",
        "voca": "^1.4.1",
        "vue": "^3.5.44"
    },
    "devDependencies": {
        "@types/vhtml": "^2.2.9",
        "@types/voca": "^1.4.6",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "globals": "^17.13.0",
        "vitest": "^4.1.12"
    }
}
